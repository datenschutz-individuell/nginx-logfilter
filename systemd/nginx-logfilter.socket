[Unit]
Description=Syslog socket for nginx-logfilter (survives restarts of the service)
Before=nginx.service

[Socket]
ListenDatagram=/run/nginx-logfilter/sock
# nginx workers send as this user (Arch: http, Debian: www-data).
SocketUser=http
SocketGroup=http
SocketMode=0600
DirectoryMode=0755

[Install]
WantedBy=sockets.target nginx.service
